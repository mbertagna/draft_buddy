# Search provider for insights-search (default: valyu)
INSIGHTS_SEARCH_PROVIDER=valyu
VALYU_API_KEY=

# Google Custom Search JSON API (optional; use --search-provider google)
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# Gemini API (insights-synthesize + live draft assistant)
GEMINI_API_KEY=
INSIGHTS_GEMINI_MODEL=gemini-2.5-flash
ADVISOR_GEMINI_MODEL=gemini-2.5-flash

# Active league profile (red_league_10 | redraft_nbfl_12)
DRAFT_BUDDY_LEAGUE=red_league_10
DRAFT_BUDDY_SEASON=2026
