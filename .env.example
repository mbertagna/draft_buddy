# Valyu search API (insights-search)
VALYU_API_KEY=

# LLM providers (insights-synthesize + live draft assistant)
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Advisor defaults (UI-overridable per team)
ADVISOR_AGENT_MODEL=deepseek/deepseek-v4-pro
ADVISOR_OTHER_TEAMS_MODEL=deepseek/deepseek-v4-flash
ADVISOR_GEMINI_MODEL=gemini-2.5-flash

# Synthesis defaults
INSIGHTS_LLM_PROVIDER=gemini
INSIGHTS_LLM_MODEL=gemini-2.5-flash
INSIGHTS_GEMINI_MODEL=gemini-2.5-flash

# Active league profile (red_league_10 | redraft_nbfl_12)
DRAFT_BUDDY_LEAGUE=red_league_10
DRAFT_BUDDY_SEASON=2026
